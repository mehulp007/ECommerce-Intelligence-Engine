FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

WORKDIR /app
COPY pyproject.toml requirements-api.txt README.md /app/
COPY src/ /app/src/
RUN python -m pip install --no-cache-dir -r requirements-api.txt

ARG BUNDLE_VERSION
COPY artifacts/bundles/${BUNDLE_VERSION}/ /app/artifacts/bundles/${BUNDLE_VERSION}/
COPY api/ /app/api/
ENV EIE_BUNDLE_DIR=/app/artifacts/bundles/${BUNDLE_VERSION}

RUN useradd --system --create-home appuser && chmod -R a-w /app/artifacts/bundles
USER appuser
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
