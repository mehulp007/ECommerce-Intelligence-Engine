# Copy this file to .env and fill in the values locally. .env is git-ignored.

# Google Gemini API key used by the analyst copilot (server-side only).
GEMINI_API_KEY=

# Optional Gemini model overrides for the copilot (defaults: gemini-3.8-flash,
# falling back to gemini-3.6-flash when the primary model is overloaded).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Shared bearer key between the web app and the local API.
EIE_API_KEY=
